[Unit]
Description=LDC P2P relay
After=network-online.target

[Service]
User=ldc
WorkingDirectory=/opt/ldc-p2p
Environment=PYTHONPATH=/opt/ldc-p2p/src
ExecStart=/opt/ldc-p2p/venv/bin/python -m ldc_p2p.server --host 0.0.0.0 --port 9443 --db /var/lib/ldc-relay/relay.db --tls-cert /etc/ldc/fullchain.pem --tls-key /etc/ldc/privkey.pem
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/ldc-relay
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
